DATABASE_URL=sqlite+aiosqlite:///./app.db
OPENAI_API_KEY=your_openai_api_key_here
TMDB_API_KEY=your_tmdb_api_key_here
MOVIE_PASS_KEY=replace_with_a_long_random_jwt_secret
DEMO_ENABLED=true
DEMO_USERNAME=reelfeel_demo
DEMO_ACCESS_CODE=replace_with_long_random_demo_code

# Low-cost AI routing defaults.
OPENAI_MODEL_CHEAP=gpt-4.1-nano
OPENAI_MODEL_STANDARD=gpt-4.1-mini
OPENAI_MAX_TOKENS_CHEAP=220
OPENAI_MAX_TOKENS_STANDARD=700
SUMMARY_SNAPSHOT_LIMIT=18
RECOMMENDATION_CANDIDATE_LIMIT=15

# Optional estimated usage logging. Defaults reflect the cheap/standard models above.
AI_USAGE_LOGGING=true
OPENAI_CHEAP_INPUT_COST_PER_1M=0.10
OPENAI_CHEAP_OUTPUT_COST_PER_1M=0.40
OPENAI_STANDARD_INPUT_COST_PER_1M=0.40
OPENAI_STANDARD_OUTPUT_COST_PER_1M=1.60
